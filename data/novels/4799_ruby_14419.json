      {
        "text": "车站的月台上",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "南瓜的藤蔓匍匐向上爬",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "紧闭的花门缝隙",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "瓢虫正看着外面",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "轻便车来了。",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "没人乘坐",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "没人下车。",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "栅栏旁边的黍的叶片上",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "年轻的时候，容易把剪刀插进去。",
