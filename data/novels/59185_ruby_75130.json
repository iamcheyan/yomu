    [
      {
        "text": "非得要将自己伸展成自己本来的样子不可。",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "孩子心里正燃烧着想要报答父亲慈爱的念头。",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "唉呀。",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "人类的道路很遥远",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "然后，那大道并不存在。",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "自然的孩子们必须用全身的力气开拓下去啊。",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "走啊，走啊",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "不管什么东西出来，都得跨过去往前走",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "踏入这光辉璀璨的风景之中吧。",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "我的前方没有道路",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "我的后面出现了一条路。",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "啊，父亲",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "父亲，让我独自站立的你",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "不要把目光从我身上移开，守护我！",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "请永远将父亲的气魄注入到我身上吧。",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
    ],
    [
      {
        "text": "为了这段遥远的旅程",
        "model": "ark",
        "model_name": "火山ARK"
      }
    ],
    [
      {
        "text": "底本：「美之废墟第六号」美之废墟社",
        "model": "zhipu",
        "model_name": "智谱AI"
      }
